# Скопируйте в .env и заполните реальными значениями: cp .env.example .env
# Затем: chmod 600 .env

# --- PostgreSQL ---
DB_HOST=db
DB_PORT=5432
DB_NAME=parts_catalog
DB_USER=parts_app
# Длинный случайный пароль: openssl rand -base64 32 | tr -d '=+/'
DB_PASSWORD=

# --- Ozon Seller API (read-only ключ) ---
OZON_CLIENT_ID=
OZON_API_KEY=

# --- FastAPI ---
# production: скрывает /docs, /redoc, /openapi.json (меньше поверхность для разведки)
APP_ENV=production
# Домен фронтенда для CORS, если когда-нибудь понадобится обращаться к API
# с другого origin. При обычном деплое (nginx проксирует /api на api:8000
# с того же домена) не нужен — оставьте пустым.
FRONTEND_ORIGIN=

# --- Секретный адрес входа в админку ---
# Админка открывается ТОЛЬКО по адресу https://<домен>/console/<ADMIN_URL_UID>/login.
# Обычные /admin и /admin/login на сайте не существуют, а админ-API (/api/admin/*)
# отвечает 404 каждому, кто не передал этот uid. Пока значение не задано —
# админка закрыта для всех (так и задумано).
# Сгенерировать:  openssl rand -hex 24
# Показать готовую ссылку:  docker compose exec api python manage_users.py admin-url
# Сменить uid = просто записать новое значение и `docker compose up -d api`
# (старая ссылка сразу перестаёт работать). 24–64 символа: A-Z a-z 0-9 _ -
ADMIN_URL_UID=

# --- Жёсткий контроль входа ---
# Сессия: абсолютный срок и простой без действий; одновременных сессий на пользователя.
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=120
MAX_SESSIONS_PER_USER=5
# Блокировка перебора пароля: столько неудач за окно (по IP и отдельно по логину)
# -> вход блокируется, пока старые неудачи не выйдут за окно.
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILS_PER_IP=10
LOGIN_MAX_FAILS_PER_USER=10
# Бан IP на час после стольких обращений к /admin* с неверным uid за 10 минут.
ADMIN_PROBE_MAX_FAILURES=8
ADMIN_PROBE_BAN_SECONDS=3600

# --- Исходящие подключения (FTP) ---
# Подключения к loopback/link-local/метаданным облака запрещены всегда, к частным
# сетям (10.x, 172.16–31.x, 192.168.x) — пока не включено. Включайте только если
# FTP-сервер действительно стоит во внутренней сети.
OUTBOUND_ALLOW_PRIVATE=0
# Потолок размера и времени скачивания прайса с FTP
FTP_MAX_FILE_MB=50
FTP_MAX_DOWNLOAD_SECONDS=300

# --- Встроенный FTP-сервер для загрузки прайсов ---
# Поставщик/менеджер загружает csv/xls/xlsx по FTPS (порт 21, шифрование обязательно),
# а в админке (Синхронизация -> Цены с FTP) указывается адрес сервера «local».
# Пароль: не короче 12 символов, 3 вида символов (иначе сервер не запустится).
# Сгенерировать: openssl rand -base64 24 | tr -d '=+/'
FTP_UPLOAD_USER=prices
FTP_UPLOAD_PASSWORD=
# Публичный IP сервера — нужен для пассивного режима
FTP_PUBLIC_IP=
FTP_PORT=21
FTP_PASV_PORTS=30000-30009
FTP_MAX_UPLOAD_MB=50
FTP_MAX_CONS_PER_IP=3
# 1 — разрешить НЕшифрованный FTP (не рекомендуется)
FTP_ALLOW_PLAIN=0

# --- Админ-панель ---
# Авторизация — именные учётные записи с ролями (viewer/editor/full), не
# переменная окружения. Ни один ADMIN_TOKEN здесь не нужен.
#
# Первая учётная запись (роль full) создаётся из контейнера api:
#   docker compose exec api python manage_users.py create-user admin --role full
# Дальше пользователей можно добавлять и через саму админку, раздел
# «Пользователи» (виден только роли full). Подробнее — см. README,
# раздел «Авторизация».

# --- Планировщик синхронизации с Ozon (минуты) ---
# Значение по умолчанию только для самого первого запуска — дальше интервал
# и вкл/выкл автосинхронизации редактируются в админке (/admin/sync) и
# хранятся в БД, эта переменная больше не перечитывается.
SYNC_INTERVAL_MINUTES=60

# --- Загрузка файлов ---
UPLOAD_DIR=/app/uploads

# Импорт цен с FTP-сервера (внешнего или встроенного «local»; адрес, логин, пароль, путь к файлу, периодичность,
# вкл/выкл) настраивается целиком в админке — раздел «Синхронизация» →
# «Цены с FTP» (/admin/sync). Переменных окружения для этого нет.
